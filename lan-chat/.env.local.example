# Copy this file to .env.local and tweak values for your LAN setup.
# The session key points at the OpenClaw conversation you want to expose.
GATEWAY_SESSION_KEY=agent:main:main

# Gateway host. Standalone Docker uses host.docker.internal; native installs use 127.0.0.1;
# the top-level Zorg MemoryDB Compose stack sets this to openclaw.
GATEWAY_HOST=127.0.0.1

# Label injected into LAN-originated chat metadata.
CHAT_SOURCE_LABEL=LAN Console

# Visible unified command-stream history limit.
CHAT_HISTORY_LIMIT=20

# Gateway call timeout (ms).
GATEWAY_CALL_TIMEOUT_MS=15000

# Next.js listen port for native/single-container installs.
PORT=3001

# Optional Whisper transcription support for the browser microphone button.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1

# Login gate. Generate a strong password, store only a PBKDF2-SHA256 hash here,
# and send the plaintext password to the operator by the approved email path.
# If email is unavailable, direct the operator/user to open OpenClaw TUI on the LAN
# and provide the password there as the secure internal-channel fallback.
# Format: pbkdf2-sha256:<iterations>:<salt>:<base64url-hash>
# LAN_CHAT_PASSWORD_HASH=pbkdf2-sha256:310000:...
# LAN_CHAT_AUTH_SECRET=<random-base64url-secret-for-cookie-signing>
