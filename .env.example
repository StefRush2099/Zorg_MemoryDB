# Copy to .env before production use on latest Ubuntu.
# Docker Compose auto-selects the first available external host port in this range.
# Default tries 18789, then 18790, and so on through 18889.
# To pin one external port, set OPENCLAW_GATEWAY_PUBLISHED_PORTS=18789.
DB_NAME=openclaw_memory
DB_USER=openclaw_memory
OPENCLAW_GATEWAY_CONTAINER_PORT=18789
OPENCLAW_GATEWAY_PUBLISHED_PORTS=18789-18889
OPENCLAW_GATEWAY_BIND=lan
# Docker build argument; leave as latest unless pinning a known-good OpenClaw release.
OPENCLAW_VERSION=latest

# Optional but strongly recommended for executive-assistant email use:
# set the operator email that must be visibly CC'd on outbound assistant email.
# OPERATOR_CC_EMAIL=operator@example.com
# Comma-separated recipient emails whose individual rule should BCC the operator instead of CC.
# OPERATOR_BCC_RECIPIENTS=family@example.com,close-friend@example.com

# Model provider keys. OpenRouter is a practical minimum path; OpenAI is the
# recommended entry-level production path. Configure one or both privately.
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...

# Messaging/channel tokens vary by provider. Examples only; keep real tokens private.
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=...

# Email OAuth/app credentials. Use a dedicated assistant mailbox when possible.
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REFRESH_TOKEN=...
# GOOGLE_MAILBOX_EMAIL=assistant@example.com
# MICROSOFT_TENANT_ID=...
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...
# MICROSOFT_REFRESH_TOKEN=...
# MICROSOFT_MAILBOX_EMAIL=assistant@example.com

# GitHub/private backup access. Use least-privilege tokens and private repos for dumps.
# GITHUB_TOKEN=...
# GITHUB_BACKUP_REPO=github.com/you/private-openclaw-backups.git

# Optional publishing connector.
# CLOUDFLARE_TUNNEL_TOKEN=...
