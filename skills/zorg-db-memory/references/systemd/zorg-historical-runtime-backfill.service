[Unit]
Description=Zorg one-time resumable historical runtime memory backfill
After=postgresql.service

[Service]
Type=simple
Environment=OPENCLAW_WORKSPACE=%h/.openclaw/workspace
Environment=SQL_MEMORY_MAP=%h/.openclaw/workspace/skills/zorg-db-memory/config/sql_memory_map.json
ExecStart=%h/.openclaw/workspace/.venv-sqlmem/bin/python %h/.openclaw/workspace/skills/zorg-db-memory/scripts/run_full_historical_completion.py
Restart=on-failure
RestartSec=15
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
