# Copy this file to .env.local and tweak values for your LAN setup.
# The session key points at the OpenClaw conversation you want to expose.
GATEWAY_SESSION_KEY=agent:main:main

# Optional: cap how many messages the history endpoint returns per poll.
CHAT_HISTORY_LIMIT=50

# Optional: override timeout (ms) for gateway calls.
GATEWAY_CALL_TIMEOUT_MS=8000

# Browser polling intervals. Keep these conservative so an open console does not
# create gateway or PostgreSQL pressure while still feeling live.
NEXT_PUBLIC_CHAT_POLL_MS=12000
NEXT_PUBLIC_DB_POLL_MS=10000

# APMT API credentials (client credentials flow).
APMT_CLIENT_ID=
APMT_CLIENT_SECRET=
# Optional: set to https://api.apmterminals.com for production.
APMT_BASE_URL=https://api-sandbox.apmterminals.com

# Shared Zorg MemoryDB paths. Set these on every host; do not assume /home/openclaw.
OPENCLAW_WORKSPACE=
SQL_MEMORY_MAP=
OPENCLAW_HOME=
OPENCLAW_SESSIONS_DIR=
OPENCLAW_BIN=
