[Unit]
Description=Zorg MemoryDB PostgreSQL-owned LLM job dispatcher
After=network-online.target openclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=%h/.openclaw/workspace
Environment=OPENCLAW_WORKSPACE=%h/.openclaw/workspace
Environment=SQL_MEMORY_MAP=%h/.openclaw/workspace/skills/zorg-db-memory/config/sql_memory_map.json
Environment=OPENCLAW_BIN=%h/.npm-global/bin/openclaw
ExecStart=%h/.openclaw/workspace/.venv-sqlmem/bin/python %h/.openclaw/workspace/skills/zorg-db-memory/scripts/memory_db_llm_dispatcher.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
